# Build parameters — read by the Justfile and the GitHub Actions workflow.

# Output image name; also the GitHub repo name.
IMAGE_NAME=bluefin-hyprland

# GitHub user/org that owns the repo and the ghcr.io namespace.
REPO_ORGANIZATION="holsee"

IMAGE_DESC="Bluefin with Hyprland baked in: uwsm session, portals, polkit agent, lock/idle/wallpaper daemons. NVIDIA open-driver base."
IMAGE_KEYWORDS="bootc,oci,bluefin,hyprland,wayland,fedora-atomic,nvidia"

IMAGE_LOGO_URL="https://raw.githubusercontent.com/hyprwm/Hyprland/main/assets/hyprland.png"

# Tracks the base image's tag so the rebase target reads like upstream's:
#   ghcr.io/holsee/bluefin-hyprland:stable
DEFAULT_TAG="stable"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
